FROM python:3.10-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy dependency files
COPY pyproject.toml .
COPY uv.lock .
COPY README.md .

# Install dependencies
RUN uv sync

# Copy application code
COPY . .

# Run the worker
CMD ["uv", "run", "python", "-m", "scheduler_v3_1.worker"]
